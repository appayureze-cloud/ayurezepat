# local.properties is generated by Flutter tooling and gitignored.
# Add this line yourself for local Android Studio / gradlew builds that need
# a real Google Maps key baked into the manifest placeholder:
MAPS_API_KEY=your-restricted-android-maps-key

# In CI, set ANDROID_MAPS_API_KEY as an environment variable/secret instead -
# build.gradle prefers it over this file.
